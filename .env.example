# Copy to .env.local and fill in. Only the chatbot needs these.

# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Upstash Redis (REST) — rate limiting + resume cache
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ID of the publicly-readable Google Doc holding the resume
# (the part between /document/d/ and /edit in its URL)
GOOGLE_DOC_ID=
