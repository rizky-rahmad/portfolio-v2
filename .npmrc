# @cloudflare/next-on-pages pins @cloudflare/workers-types@^4 and has not been
# released since Sep 2025, while every current wrangler requires ^5 — npm refuses
# the install and the Cloudflare build dies before it reads the project at all.
# The peer is peerOptional, so nothing actually needs it; only npm's strictness
# is in the way.
#
# ponytail: unblocks deploys today. The real fix is migrating off next-on-pages,
# which Cloudflare deprecated in favour of the OpenNext adapter.
legacy-peer-deps=true
